# ===== BIẾN MÔI TRƯỜNG CHO RAILWAY (service keybot → Variables → RAW Editor → dán vào) =====
# Đây là bản mẫu thay cho config.env. Biến đặt trên Railway được ưu tiên hơn config.env.
# Điền các chỗ <...> rồi dán. Xóa dòng nào không dùng cũng được.

# --- Bắt buộc ---
BOT_TOKEN=<token mới từ @BotFather>
SUNVIW_URL=https://apisun8-production-cb48.up.railway.app
# GIỐNG HỆT biến SUNVIW_BOT_SECRET đang đặt ở server sunviw (>= 24 ký tự)
SUNVIW_BOT_SECRET=<chuỗi bí mật>
# ID đầu tiên = admin chính
ADMIN_CHAT_IDS=8764934889

# --- Lưu dữ liệu (cần gắn Volume, Mount path = /data) ---
DB_PATH=/data/shop.db

# --- Hiển thị / CSKH ---
BOT_NAME=KEY SHOP
CSKH_USERNAME=
CSKH_ID=

# --- Nhận tiền ---
BANK_NAME=MB Bank
BANK_CODE=MB
BANK_ACCOUNT=666666660108
BANK_OWNER=VU DUY MANH
MIN_DEPOSIT=10000
MAX_DEPOSIT=50000000
QR_FILE=qr.jpg
USE_DYNAMIC_QR=0

# --- Box feedback / thông báo nạp & mua key ---
FEEDBACK_CHAT_ID=-5096109010
FEEDBACK_THREAD_ID=
FEEDBACK_MASK_NAME=0
NOTIFY_CHAT_ID=
NOTIFY_THREAD_ID=
